index 0000000..a8b02dd
--- /dev/null
+++ b/packages/coding-agent/test/sidebar-layout.test.ts
@@ -0,0 +1,49 @@
+import { Text } from "@earendil-works/pi-tui";
+import { describe, expect, test } from "vitest";
+import { renderLayoutFrame } from "../../tui/src/layout.ts";
+import { SidebarLayout } from "../src/modes/interactive/sidebar-layout.ts";
+
+describe("pinned sidebar layout", () => {
+	test("reserves width, collapses on narrow/short screens and restores focus", () => {
+		const sidebar = { focused: true, render: () => ["sessions"], invalidate: () => {} };
+		let unfocused = 0;
+		const layout = new SidebarLayout(new Text("chat", 0, 0), () => {
+			unfocused++;
+			sidebar.focused = false;
+		});
+		layout.setSidebar(sidebar);
+		const wide = renderLayoutFrame(layout, 130, 24, () => {});
+		expect(wide.root.children.map((child) => child.rect.width)).toEqual([88, 42]);
+		const narrow = renderLayoutFrame(layout, 80, 24, () => {});
+		expect(narrow.root.children.map((child) => child.rect.width)).toEqual([80]);
+		expect(unfocused).toBe(1);
+		expect(renderLayoutFrame(layout, 130, 8, () => {}).root.children).toHaveLength(1);
+		expect(renderLayoutFrame(layout, 130, 24, () => {}).root.children).toHaveLength(2);
+	});
+
+	test("replacement and removal dispose each component once", () => {
+		let disposed = 0;
+		const layout = new SidebarLayout(new Text("chat", 0, 0), () => {});
+		const create = () => ({
+			focused: false,
+			render: () => ["sessions"],
+			invalidate: () => {},
+			dispose: () => {
+				disposed++;
+			},
+		});
+		layout.setSidebar(create());
+		layout.setSidebar(create());
+		expect(disposed).toBe(1);
+		layout.setSidebar();
+		layout.setSidebar();
+		expect(disposed).toBe(2);
+		expect(renderLayoutFrame(layout, 130, 24, () => {}).root.children).toHaveLength(1);
+	});
+
+	test("invalid dimensions are rejected", () => {
+		const layout = new SidebarLayout(new Text("chat", 0, 0), () => {});
+		const sidebar = { focused: false, render: () => [], invalidate: () => {} };
+		expect(() => layout.setSidebar(sidebar, Number.NaN)).toThrow("Sidebar dimensions");
+	});
+});
