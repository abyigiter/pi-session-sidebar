diff --git a/packages/tui/test/sidebar-input.test.ts b/packages/tui/test/sidebar-input.test.ts
new file mode 100644
index 0000000..9f44137
--- /dev/null
+++ b/packages/tui/test/sidebar-input.test.ts
@@ -0,0 +1,53 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { HStack } from "../src/components/h-stack.ts";
+import { ScrollView } from "../src/components/scroll-view.ts";
+import { Text } from "../src/components/text.ts";
+import { TuiAltScreen } from "../src/tui-alt-screen.ts";
+import { VirtualTerminal } from "./virtual-terminal.ts";
+
+test("focused sidebar owns paging keys while overlays keep priority", async () => {
+	const terminal = new VirtualTerminal(130, 24);
+	const tui = new TuiAltScreen(terminal);
+	const transcript = new ScrollView(
+		new Text(Array.from({ length: 80 }, (_, index) => `line ${index}`).join("\n"), 0, 0),
+		{ primary: true, follow: "end" },
+	);
+	const inputs: string[] = [];
+	const sidebar = {
+		focused: false,
+		captureViewportInput: true,
+		render: () => ["sessions"],
+		invalidate: () => {},
+		handleInput: (data: string) => {
+			inputs.push(data);
+		},
+	};
+	tui.setLayoutRoot(
+		new HStack([
+			{ component: transcript, basis: 0, grow: 1 },
+			{ component: sidebar, basis: 42, shrink: 0 },
+		]),
+	);
+	tui.start();
+	await terminal.waitForRender();
+	const before = transcript.scrollTop;
+	tui.setFocus(sidebar);
+	terminal.sendInput("\x1b[5~");
+	assert.deepEqual(inputs, ["\x1b[5~"]);
+	assert.equal(transcript.scrollTop, before);
+	const overlayInputs: string[] = [];
+	const overlay = tui.showOverlay({
+		render: () => ["dialog"],
+		invalidate: () => {},
+		handleInput: (data) => {
+			overlayInputs.push(data);
+		},
+	});
+	terminal.sendInput("x");
+	assert.deepEqual(overlayInputs, ["x"]);
+	assert.equal(inputs.length, 1);
+	overlay.hide();
+	assert.equal(sidebar.focused, true);
+	tui.stop();
+});
