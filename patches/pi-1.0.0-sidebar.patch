index 0000000..a934ca6
--- /dev/null
+++ b/packages/coding-agent/src/modes/interactive/sidebar-layout.ts
@@ -0,0 +1,49 @@
+import { type Component, type Focusable, HStack } from "@earendil-works/pi-tui";
+
+export type SidebarComponent = Component & Focusable & { dispose?(): void };
+
+/** Keep the existing chat viewport intact while reserving a sibling column. */
+export class SidebarLayout extends HStack {
+	private sidebar: SidebarComponent | undefined;
+	private width = 42;
+	private minChatWidth = 60;
+	private readonly onUnfocus: () => void;
+
+	constructor(chat: Component, onUnfocus: () => void) {
+		super([{ component: chat, basis: 0, grow: 1, shrink: 1, minSize: 1 }]);
+		this.onUnfocus = onUnfocus;
+	}
+
+	isVisible(component: SidebarComponent, width: number, height: number): boolean {
+		return this.sidebar === component && width >= this.width + this.minChatWidth && height >= 12;
+	}
+
+	setSidebar(component?: SidebarComponent, width = 42, minChatWidth = 60): void {
+		const previous = this.sidebar;
+		this.sidebar = undefined;
+		if (previous) {
+			if (previous.focused) this.onUnfocus();
+			this.removeChild(previous);
+			previous.dispose?.();
+		}
+		if (!component) return;
+		if (!Number.isSafeInteger(width) || width < 16 || !Number.isSafeInteger(minChatWidth) || minChatWidth < 1) {
+			throw new Error("Sidebar dimensions must be positive integers (width >= 16)");
+		}
+		this.width = width;
+		this.minChatWidth = minChatWidth;
+		this.sidebar = component;
+		this.addChild(component, {
+			basis: width,
+			grow: 0,
+			shrink: 0,
+			minSize: width,
+			maxSize: width,
+			visible: (viewport) => {
+				const visible = this.isVisible(component, viewport.width, viewport.height);
+				if (!visible && component.focused) this.onUnfocus();
+				return visible;
+			},
+		});
+	}
+}
diff --git a/packages/coding-agent/test/sidebar-layout.test.ts b/packages/coding-agent/test/sidebar-layout.test.ts
